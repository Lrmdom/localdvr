# Cloudflare R2 Settings
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
AWS_ACCESS_KEY_ID=sua_access_key_r2_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_r2_aqui
R2_BUCKET_NAME=cameras-recordings

# Recording Configuration
SEGMENT_DURATION_SECONDS=300
TEMP_STORAGE_PATH=./temp_recordings
LOG_LEVEL=INFO

# Cameras Configuration (JSON format for multi-camera scalability)
CAMERAS='[{"name": "tplink_exterior", "rtsp_url": "rtsp://admin:password@192.168.1.100:554/stream1"}, {"name": "lsc_rotativa", "rtsp_url": "rtsp://admin:password@192.168.1.101:554/live/ch0"}]'
